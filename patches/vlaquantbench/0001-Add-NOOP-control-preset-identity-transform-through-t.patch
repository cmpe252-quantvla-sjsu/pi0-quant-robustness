diff --git a/tests/test_noop_preset.py b/tests/test_noop_preset.py
new file mode 100644
index 0000000..58fe91a
--- /dev/null
+++ b/tests/test_noop_preset.py
@@ -0,0 +1,96 @@
+"""NOOP control preset: same code path as a real quantizer, bit-identical result.
+
+The proposal's E0/E1 parity check compares a NOOP cell against the BASELINE cell.
+For that comparison to mean anything, NOOP must (1) actually walk and rewrite the
+same layers as W4 for the same scope, and (2) leave every weight bit-identical.
+"""
+import pytest
+import torch
+from torch import nn
+
+from vlaquantbench import ComponentMap, parse_spec, quantize_scope
+from vlaquantbench.quant.apply import _QUANT_MARK_ATTR
+from vlaquantbench.quant.presets import BASELINE, NOOP, PRESETS
+
+
+class ToyVLA(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.vision_blocks = nn.Sequential(nn.Linear(8, 256), nn.GELU(), nn.Linear(256, 8))
+        self.projector = nn.Linear(8, 16)
+        self.layers = nn.Sequential(nn.Linear(16, 32), nn.SiLU(), nn.Linear(32, 16))
+        self.action_head = nn.Sequential(nn.Linear(16, 16), nn.ReLU(), nn.Linear(16, 7))
+
+    def forward(self, x):
+        return self.action_head(self.layers(self.projector(self.vision_blocks(x))))
+
+
+def cmap_of(m):
+    cm = ComponentMap()
+    cm.add("ve", "vision_blocks", m.vision_blocks)
+    cm.add("mp", "projector", m.projector)
+    cm.add("llm", "layers", m.layers)
+    cm.add("ah", "action_head", m.action_head)
+    return cm
+
+
+def bit_identical(a: torch.Tensor, b: torch.Tensor) -> bool:
+    """Exact equality of the stored bits (stricter than value equality: -0.0 vs 0.0)."""
+    int_view = {torch.float32: torch.int32, torch.bfloat16: torch.int16, torch.float16: torch.int16}[a.dtype]
+    return a.dtype == b.dtype and torch.equal(a.view(int_view), b.view(int_view))
+
+
+def test_parse_noop_is_a_control_not_the_baseline():
+    spec = parse_spec("noop")
+    assert spec is NOOP and spec.name == "NOOP"
+    assert not spec.is_baseline          # so quantize_modules does NOT return early
+    assert spec.weight.bits == 16 and spec.act is None
+    assert "NOOP" in PRESETS
+    assert parse_spec("W16") is BASELINE  # existing meaning unchanged
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16, torch.float16])
+@pytest.mark.parametrize("scope", ["ve", "e2e", "llm+ah"])
+def test_noop_leaves_every_parameter_bit_identical(dtype, scope):
+    torch.manual_seed(0)
+    m = ToyVLA().to(dtype)
+    with torch.no_grad():  # include awkward values: signed zero, tiny and huge magnitudes
+        m.vision_blocks[0].weight[0, :4] = torch.tensor([-0.0, 1e-30, -3e4, 7.0], dtype=torch.float32).to(dtype)
+    before = {n: p.detach().clone() for n, p in m.named_parameters()}
+    reports = quantize_scope(cmap_of(m), NOOP, scope=scope, compute_error=True)
+    assert sum(r.n_layers for r in reports.values()) > 0
+    for n, p in m.named_parameters():
+        assert bit_identical(p.detach(), before[n]), n
+    for r in reports.values():
+        assert r.mean_rel_mse() == 0.0
+
+
+def test_noop_selects_exactly_the_layers_w4_would_quantize():
+    m_noop, m_w4 = ToyVLA(), ToyVLA()
+    r_noop = quantize_scope(cmap_of(m_noop), NOOP, scope="ve")
+    r_w4 = quantize_scope(cmap_of(m_w4), parse_spec("W4"), scope="ve")
+    assert [l.name for l in r_noop["ve"].layers] == [l.name for l in r_w4["ve"].layers]
+    assert r_noop["ve"].n_params == r_w4["ve"].n_params
+    # the path really ran: in-scope modules are marked, out-of-scope ones are not
+    assert getattr(m_noop.vision_blocks[0], _QUANT_MARK_ATTR) == "NOOP"
+    assert getattr(m_noop.action_head[0], _QUANT_MARK_ATTR, None) is None
+
+
+def test_noop_forward_output_is_bit_identical():
+    torch.manual_seed(1)
+    m = ToyVLA().to(torch.bfloat16).eval()
+    x = torch.randn(4, 8).to(torch.bfloat16)
+    with torch.no_grad():
+        y0 = m(x)
+        quantize_scope(cmap_of(m), NOOP, scope="e2e")
+        y1 = m(x)
+    assert bit_identical(y0, y1)
+
+
+def test_w4_still_changes_weights():
+    """Guard against the NOOP edit accidentally turning real quantization off."""
+    torch.manual_seed(2)
+    m = ToyVLA()
+    w = m.vision_blocks[0].weight.detach().clone()
+    quantize_scope(cmap_of(m), parse_spec("W4"), scope="ve")
+    assert not torch.equal(w, m.vision_blocks[0].weight)
