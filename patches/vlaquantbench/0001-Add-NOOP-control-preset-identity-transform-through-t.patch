diff --git a/vlaquantbench/quant/fake_quant.py b/vlaquantbench/quant/fake_quant.py
index c4dd79b..bd1602a 100644
--- a/vlaquantbench/quant/fake_quant.py
+++ b/vlaquantbench/quant/fake_quant.py
@@ -135,10 +135,13 @@ def fake_quant_weight(weight: torch.Tensor, spec: WeightQuantSpec) -> torch.Tens
     channel first (``nn.Conv2d``: ``[out, in, kh, kw]``); N-D weights are
     flattened to ``[out, -1]`` for grouping and reshaped back.
     """
-    if spec.bits >= 16:
-        return weight.clone()
     orig_shape, orig_dtype = weight.shape, weight.dtype
     w = weight.detach().reshape(orig_shape[0], -1).to(torch.float32)
+    if spec.bits >= 16:
+        # Identity transform (the NOOP control preset): the weight takes the same
+        # reshape -> float32 -> cast-back path as a real quantizer, without rounding.
+        # bf16/fp16 -> fp32 -> bf16/fp16 is exact, so the result is bit-identical.
+        return w.reshape(orig_shape).to(orig_dtype).clone()
     out_f, in_f = w.shape
 
     if spec.granularity == "per_tensor":
diff --git a/vlaquantbench/quant/presets.py b/vlaquantbench/quant/presets.py
index 8a1fe5e..d0cef24 100644
--- a/vlaquantbench/quant/presets.py
+++ b/vlaquantbench/quant/presets.py
@@ -7,6 +7,11 @@ Preset grammar (case-insensitive)::
 Examples: ``W4`` ``W3`` ``W8`` ``W4A8`` ``W4A4`` ``W8A8`` ``W2`` ``W3G64``
 ``W4A8SYM`` ``W16`` (= baseline, no-op).
 
+``NOOP`` is a control, not a baseline: it runs the full weight-quantization path
+(layer selection, in-place weight rewrite, module marking, quantization report)
+with an identity transform, so a NOOP cell must reproduce the BASELINE cell. A
+mismatch points at the harness, not at quantization.
+
 Defaults when the modifiers are omitted follow the benchmark protocol:
 
 ==========  =====================================  =====================
@@ -60,6 +65,8 @@ def parse_spec(text: str, *, default_group_size: int = DEFAULT_GROUP_SIZE) -> Qu
     key = text.strip().replace("-", "").replace("_", "").upper()
     if key in ("BASELINE", "FP", "BF16", "FP32", "FP16", "NONE", "W16"):
         return BASELINE
+    if key == "NOOP":
+        return NOOP
     m = _PATTERN.match(key)
     if not m:
         raise ValueError(
@@ -100,8 +107,13 @@ def parse_spec(text: str, *, default_group_size: int = DEFAULT_GROUP_SIZE) -> Qu
 
 BASELINE = QuantSpec(name="BASELINE")
 
+#: Identity control: is_baseline is False, so quantize_modules walks and rewrites every
+#: in-scope layer exactly as for W4/W8, but fake_quant_weight(bits=16) changes nothing.
+NOOP = QuantSpec(name="NOOP", weight=WeightQuantSpec(bits=16, granularity="per_channel"))
+
 #: The six settings evaluated in the paper plus W2 (added for the released benchmark).
 PRESETS: dict[str, QuantSpec] = {
     name: parse_spec(name) for name in ("W2", "W3", "W4", "W8", "W4A4", "W4A8", "W8A8")
 }
 PRESETS["BASELINE"] = BASELINE
+PRESETS["NOOP"] = NOOP
